# Copy to backend/.env — local development defaults below.
# Production: set the same keys in Railway (PostgreSQL required; no sqlite).

DATABASE_URL=sqlite:///./nestopia_dev.db
SECRET_KEY=dev-secret-change-in-production
SESSION_SECRET_KEY=dev-session-secret-change-in-production
FRONTEND_URL=http://localhost:3000
# Comma-separated; production must include your Vercel URL exactly (with https://)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
USE_ML_MATCHING=false
USE_SEMANTIC_MATCHING=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Google OAuth (local redirect: http://localhost:3000/api/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Production (Railway) — uncomment/adapt in dashboard, not in a second file ---
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# SECRET_KEY=<32+ random chars>
# SESSION_SECRET_KEY=<32+ random chars>
# FRONTEND_URL=https://nestopia-rental.vercel.app
# CORS_ORIGINS=https://nestopia-rental.vercel.app
# API_PUBLIC_URL=https://nestopia-production.up.railway.app
# GOOGLE_REDIRECT_URI=https://nestopia-production.up.railway.app/api/auth/google/callback
