# Copy to backend/.env — local development defaults below.
# Production: Render (render.yaml). PostgreSQL required; no sqlite.

DATABASE_URL=sqlite:///./nestopia_dev.db
SECRET_KEY=dev-secret-change-in-production
SESSION_SECRET_KEY=dev-session-secret-change-in-production
FRONTEND_URL=http://localhost:3000
# Comma-separated; production must include your Vercel URL exactly (with https://)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
USE_ML_MATCHING=false
USE_SEMANTIC_MATCHING=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Google OAuth (local redirect: http://localhost:3000/api/auth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Production (Render) — set in the Blueprint / dashboard, not in this file ---
# DATABASE_URL comes from nestopia-db (render.yaml fromDatabase)
# SECRET_KEY and SESSION_SECRET_KEY are generated by the Blueprint
# FRONTEND_URL=https://nestopia-rental.vercel.app
# CORS_ORIGINS=https://nestopia-rental.vercel.app
# API_PUBLIC_URL is filled from RENDER_EXTERNAL_URL when unset
# GOOGLE_REDIRECT_URI defaults to $API_PUBLIC_URL/api/auth/google/callback
# UPLOADS_DIR=/data/uploads
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
