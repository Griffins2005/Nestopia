# =============================================================================
# LOCAL DEVELOPMENT — copy to backend/.env
# =============================================================================
DATABASE_URL=sqlite:///./nestopia_dev.db
SECRET_KEY=dev-secret-change-in-production
SESSION_SECRET_KEY=dev-session-secret-change-in-production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
USE_ML_MATCHING=false
USE_SEMANTIC_MATCHING=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional — only if running Celery locally
# REDIS_URL=redis://localhost:6379/0

# Optional Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# =============================================================================
# RAILWAY PRODUCTION — set in Railway → Variables (NOT sqlite / localhost)
# =============================================================================
#
# 1. Add PostgreSQL: Project → + New → Database → PostgreSQL
# 2. On your API service → Variables → add:
#
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#    (Railway gives postgres:// — the app auto-converts to postgresql+psycopg2)
#
# SECRET_KEY=<paste output of: python -c "import secrets; print(secrets.token_urlsafe(48))">
# SESSION_SECRET_KEY=<paste another random string>
#
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app
# API_PUBLIC_URL=https://your-service.up.railway.app
#
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
#
# USE_ML_MATCHING=false
# (Do NOT set REDIS_URL unless you add Redis + Celery — not required)
#
# Optional Google OAuth:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-service.up.railway.app/api/auth/google/callback
#
# If FRONTEND_URL is https + API_PUBLIC_URL is set, COOKIE_SECURE and
# COOKIE_SAMESITE=none are applied automatically even if you omit them.
