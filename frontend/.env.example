# Copy to .env.local for local overrides (never commit secrets).
#
# Local dev: leave REACT_APP_API_BASE_URL unset so CRA proxies /api → localhost:8000
# (required for httpOnly cookies without cross-origin setup).
#
# Production (Vercel): set in Project → Settings → Environment Variables:
#   REACT_APP_API_BASE_URL=https://your-backend.example.com

# REACT_APP_API_BASE_URL=https://your-backend.example.com
