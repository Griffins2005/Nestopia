# Copy to frontend/.env for local overrides (never commit real .env files).
#
# Local: leave REACT_APP_API_BASE_URL unset — CRA proxies /api → localhost:8000.
# Production (Vercel dashboard — must include https://):
# REACT_APP_API_BASE_URL=https://nestopia-api.onrender.com

# REACT_APP_API_BASE_URL=http://localhost:8000
